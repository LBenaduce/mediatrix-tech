{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/area-interna/:path*",
      "destination": "/"
    },
    {
      "source": "/en",
      "destination": "/en/index.html"
    },
    {
      "source": "/pt",
      "destination": "/pt/index.html"
    },
    {
      "source": "/es",
      "destination": "/es/index.html"
    },
    {
      "source": "/fr",
      "destination": "/fr/index.html"
    },
    {
      "source": "/de",
      "destination": "/de/index.html"
    },
    {
      "source": "/zh",
      "destination": "/zh/index.html"
    },
    {
      "source": "/hi",
      "destination": "/hi/index.html"
    },
    {
      "source": "/ar",
      "destination": "/ar/index.html"
    },
    {
      "source": "/criacao-de-sites-santa-maria-rs",
      "destination": "/criacao-de-sites-santa-maria-rs/index.html"
    },
    {
      "source": "/servicos",
      "destination": "/servicos/index.html"
    },
    {
      "source": "/portfolio",
      "destination": "/portfolio/index.html"
    },
    {
      "source": "/empresa",
      "destination": "/empresa/index.html"
    },
    {
      "source": "/contato",
      "destination": "/contato/index.html"
    },
    {
      "source": "/brazil",
      "destination": "/brazil/index.html"
    },
    {
      "source": "/us",
      "destination": "/us/index.html"
    },
    {
      "source": "/europe",
      "destination": "/europe/index.html"
    },
    {
      "source": "/switzerland",
      "destination": "/switzerland/index.html"
    },
    {
      "source": "/brazilian-businesses-abroad",
      "destination": "/brazilian-businesses-abroad/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/area-interna/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
