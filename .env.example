# Google Tag Manager container used to load Google Ads and analytics tags.
VITE_GTM_ID=GTM-XXXXXXX

# Optional Google Search Console verification token. Leave blank until Google supplies the real value.
VITE_GOOGLE_SITE_VERIFICATION=

# Server-only Vercel variables. Never prefix these values with VITE_.
# Generate ADMIN_PASSWORD_HASH with: npm run admin:hash -- "sua-senha-longa"
ADMIN_PASSWORD_HASH=scrypt:BASE64URL_SALT:BASE64URL_HASH
# Use a random value with at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-server-secret

# Server-only AI assistant variables. Never prefix these values with VITE_.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
